+        message(STATUS "Using private BoringSSL from ${PROJECT_SOURCE_DIR}/ssl")
+        set(OLS_HAVE_BORINGSSL TRUE)
+    else()
+        message(FATAL_ERROR
+            "USE_SYSTEM_LIBS requires a private BoringSSL build in ssl/ "
