+    find_package(ZLIB REQUIRED)
+    set(ZLIB_LIBRARIES ZLIB::ZLIB)
+
+    # --- PCRE2 (upstream switched from PCRE1 in 1.9.1) ---
+    pkg_check_modules(PCRE2 REQUIRED libpcre2-8)
+
+    # --- Expat ---
+    find_package(EXPAT REQUIRED)
+    set(EXPAT_LIBRARIES EXPAT::EXPAT)
+
+    # --- libxml2 ---
+    find_package(LibXml2 REQUIRED)
+    set(XML2_LIBRARIES LibXml2::LibXml2)
+
+    # --- Brotli (optional) ---
+    pkg_check_modules(BROTLI libbrotlienc libbrotlidec)
+    if (BROTLI_FOUND)
+        add_definitions(-DUSE_BROTLI)
+    else()
+        message(WARNING "Brotli not found -- brotli compression disabled")
+    endif()
+
+    # --- libmaxminddb (optional) ---
+    pkg_check_modules(MAXMINDDB libmaxminddb)
+    if (MAXMINDDB_FOUND)
+        add_definitions(-DENABLE_IPTOGEO2)
+    else()
+        message(WARNING "libmaxminddb not found -- GeoIP2 support disabled")
+    endif()
+
+    # --- udns ---
+    # udns has no .pc; fall back to a manual check
+    find_library(UDNS_LIBRARY NAMES udns)
+    find_path(UDNS_INCLUDE_DIR NAMES udns.h)
+    if (UDNS_LIBRARY AND UDNS_INCLUDE_DIR)
+        set(UDNS_LIBRARIES ${UDNS_LIBRARY})
+        include_directories(${UDNS_INCLUDE_DIR})
+    else()
+        message(FATAL_ERROR "libudns not found (need libudns-dev / udns-devel)")
+    endif()
+
+    # --- IP2Location (optional) ---
+    find_library(IP2LOC_LIBRARY NAMES IP2Location)
+    find_path(IP2LOC_INCLUDE_DIR NAMES IP2Location.h)
