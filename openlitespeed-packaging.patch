+    if (EXISTS "${PROJECT_SOURCE_DIR}/ssl/include/openssl/aead.h"
+        AND EXISTS "${PROJECT_SOURCE_DIR}/ssl/libssl.a")
+        set(SSL_INCLUDE_DIRS "${PROJECT_SOURCE_DIR}/ssl/include")
+        set(SSL_LIBRARIES
