+###############################################################################
+# Distribution packaging options
+###############################################################################
+OPTION(USE_SYSTEM_LIBS "Link against system shared libraries instead of bundled static archives" OFF)
+OPTION(FHS_LAYOUT     "Install to FHS-compliant paths (/etc, /var/log, /usr/share, ...)" OFF)
+
+###############################################################################
+# When USE_SYSTEM_LIBS is ON, locate every dependency via find_package /
+# pkg_check_modules.  Otherwise fall back to the legacy bundled-library paths.
+###############################################################################
+if (USE_SYSTEM_LIBS)
+    include(FindPkgConfig)
+
+    # --- OpenSSL (replaces bundled BoringSSL) ---
+    find_package(OpenSSL REQUIRED)
+    set(SSL_LIBRARIES OpenSSL::SSL OpenSSL::Crypto)
+    set(SSL_INCLUDE_DIRS ${OPENSSL_INCLUDE_DIR})
+
+    # --- zlib ---
+    find_package(ZLIB REQUIRED)
+    set(ZLIB_LIBRARIES ZLIB::ZLIB)
+
+    # --- PCRE ---
+    pkg_check_modules(PCRE REQUIRED libpcre)
+
+    # --- Expat ---
+    find_package(EXPAT REQUIRED)
+    set(EXPAT_LIBRARIES EXPAT::EXPAT)
+
+    # --- libxml2 ---
+    find_package(LibXml2 REQUIRED)
+    set(XML2_LIBRARIES LibXml2::LibXml2)
+
+    # --- Brotli (optional) ---
+    pkg_check_modules(BROTLI libbrotlienc libbrotlidec)
+    if (BROTLI_FOUND)
+        add_definitions(-DUSE_BROTLI)
+    else()
+        message(WARNING "Brotli not found -- brotli compression disabled")
+    endif()
+
+    # --- libmaxminddb (optional) ---
+    pkg_check_modules(MAXMINDDB libmaxminddb)
+    if (MAXMINDDB_FOUND)
+        add_definitions(-DENABLE_IPTOGEO2)
+    else()
+        message(WARNING "libmaxminddb not found -- GeoIP2 support disabled")
+    endif()
+
+    # --- udns ---
+    # udns has no .pc; fall back to a manual check
+    find_library(UDNS_LIBRARY NAMES udns)
+    find_path(UDNS_INCLUDE_DIR NAMES udns.h)
+    if (UDNS_LIBRARY AND UDNS_INCLUDE_DIR)
+        set(UDNS_LIBRARIES ${UDNS_LIBRARY})
+        include_directories(${UDNS_INCLUDE_DIR})
+    else()
+        message(FATAL_ERROR "libudns not found (need libudns-dev / udns-devel)")
+    endif()
+
+    # --- IP2Location (optional) ---
+    find_library(IP2LOC_LIBRARY NAMES IP2Location)
+    find_path(IP2LOC_INCLUDE_DIR NAMES IP2Location.h)
+    if (IP2LOC_LIBRARY AND IP2LOC_INCLUDE_DIR)
+        set(IP2LOC_LIBRARIES ${IP2LOC_LIBRARY})
+        include_directories(${IP2LOC_INCLUDE_DIR})
+        add_definitions(-DUSE_IP2LOCATION)
+    else()
+        set(IP2LOC_LIBRARIES "")
+        message(STATUS "IP2Location not found -- disabled")
+    endif()
+
+    # Propagate include dirs from pkg-config results
+    include_directories(${SSL_INCLUDE_DIRS} ${PCRE_INCLUDE_DIRS}
+                        ${BROTLI_INCLUDE_DIRS} ${MAXMINDDB_INCLUDE_DIRS})
+    link_directories(${PCRE_LIBRARY_DIRS} ${BROTLI_LIBRARY_DIRS}
+                     ${MAXMINDDB_LIBRARY_DIRS})
+endif()
+
+INCLUDE( ${PROJECT_SOURCE_DIR}/CMakeModules/common.cmake)
+
